def filter_sessions(sessions: list[str], *, prefix: str | None, contains: str | None) -> list[str]:
    if prefix is not None:
        sessions = [session for session in sessions if session.startswith(prefix)]
    if contains is not None:
        sessions = [session for session in sessions if contains in session]
    return sessions


def list_sessions(config: Config, *, reverse: bool = False) -> list[str]:
    command = "zellij list-sessions --short --no-formatting"
    if reverse:
        command += " --reverse"
    proc = run_remote(config, command)
    output = "\n".join(part for part in [proc.stdout, proc.stderr] if part)
    if "No active zellij sessions found" in output:
        return []
    if proc.returncode != 0:
        raise remote_error(proc, "list sessions")

    sessions: list[str] = []
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if not line or "No active zellij sessions found" in line:
            continue
        sessions.append(line)
    return sessions


def is_missing_session_output(output: str) -> bool:
    return "No session named" in output or "not found" in output


def session_exists(config: Config, session: str) -> bool:
    return session in list_sessions(config)


def ensure_session(
    config: Config,
    session: str,
    *,
    json_output: bool = False,
    print_only: bool = False,
) -> int:
    command = remote_cmd(config, f"zellij attach --create-background {shlex.quote(session)}")
    argv = [*ssh_args(config, batch=True), command]
    if print_only:
        print_command(argv)
        return 0

    proc = subprocess.run(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    data = {
        "host": config.host,
        "session": session,
        "ensured": proc.returncode == 0,
        "stdout": proc.stdout.strip(),
        "stderr": proc.stderr.strip(),
    }
    if json_output:
        print_json(data)
    elif proc.stdout:
        print(proc.stdout, end="")
    if proc.returncode != 0:
        if not json_output and proc.stderr:
            print(proc.stderr, end="", file=sys.stderr)
        return proc.returncode
    if not json_output and not proc.stdout:
        print(session)
    return 0


def attach(
    config: Config,
    session: str,
    *,
    create: bool,
    background: bool,
    json_output: bool,
    print_only: bool,
) -> int:
    if background:
        return ensure_session(config, session, json_output=json_output, print_only=print_only)

    flags = " --create" if create else ""
    command = remote_cmd(config, f"exec zellij attach{flags} {shlex.quote(session)}")
    if config.transport == "mosh":
        argv = ["mosh", config.host, "--", "sh", "-lc", command]
    else:
        argv = [*ssh_args(config, batch=False, tty=True), command]

    if print_only:
        print_command(argv)
        return 0
    if json_output:
        print_json({"host": config.host, "session": session, "attached": False, "command": shlex.join(argv)})
        return 0
    return subprocess.call(argv)


def attach_local(
    session: str,
    *,
    create: bool,
    background: bool,
    json_output: bool,
    print_only: bool,
) -> int:
    zellij = shutil.which("zellij")
    if zellij is None:
        raise ZtError("local zellij not found; run 'zt install --with-local-zellij'", 127)

    if background:
        argv = [zellij, "attach", "--create-background", session]
    else:
        argv = [zellij, "attach"]
        if create:
            argv.append("--create")
        argv.append(session)

    if print_only:
        print_command(argv)
        return 0
    if json_output:
        print_json({"scope": "local", "session": session, "attached": False, "command": shlex.join(argv)})
        return 0
    return subprocess.call(argv)


def kill_session(config: Config, session: str, *, missing_ok: bool, json_output: bool) -> int:
    if missing_ok and not session_exists(config, session):
        data = {"host": config.host, "session": session, "closed": False, "missing": True}
        if json_output:
            print_json(data)
        return 0

    proc = run_remote(config, f"zellij kill-session {shlex.quote(session)}")
    missing = proc.returncode != 0 and is_missing_session_output(f"{proc.stdout}\n{proc.stderr}")
    if missing_ok and missing:
        if json_output:
            print_json({"host": config.host, "session": session, "closed": False, "missing": True})
        return 0

    data = {
        "host": config.host,
        "session": session,
        "closed": proc.returncode == 0,
        "missing": missing,
        "stdout": proc.stdout.strip(),
        "stderr": proc.stderr.strip(),
    }
    if json_output:
        print_json(data)
    else:
        if proc.stdout:
            print(proc.stdout, end="")
        if proc.returncode != 0 and proc.stderr:
            print(proc.stderr, end="", file=sys.stderr)
    return proc.returncode


def delete_session(config: Config, session: str, *, force: bool, missing_ok: bool, json_output: bool) -> int:
    force_flag = " --force" if force else ""
    proc = run_remote(config, f"zellij delete-session{force_flag} {shlex.quote(session)}")
    missing = proc.returncode != 0 and is_missing_session_output(f"{proc.stdout}\n{proc.stderr}")
    if missing_ok and missing:
        if json_output:
            print_json({"host": config.host, "session": session, "deleted": False, "missing": True})
        return 0

    data = {
        "host": config.host,
        "session": session,
        "deleted": proc.returncode == 0,
        "missing": missing,
        "force": force,
        "stdout": proc.stdout.strip(),
        "stderr": proc.stderr.strip(),
    }
    if json_output:
        print_json(data)
    else:
        if proc.stdout:
            print(proc.stdout, end="")
        if proc.returncode != 0 and proc.stderr:
            print(proc.stderr, end="", file=sys.stderr)
    return proc.returncode


def choose_with_fzf(items: list[str]) -> str | None:
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not shutil.which("fzf"):
        return None
    proc = subprocess.run(
        ["fzf", "--prompt", "zellij> ", "--height", "40%", "--reverse"],
        input="\n".join(items) + "\n",
        text=True,
        stdout=subprocess.PIPE,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def prompt_choice(sessions: list[str]) -> str:
    if not sessions:
        return prompt_new_name()

    for index, session in enumerate(sessions, start=1):
        print(f"{index:2d}. {session}")
    print(f"{len(sessions) + 1:2d}. {NEW_MARKER}")

    answer = input("session> ").strip()
    if not answer:
        return ""
    if answer.isdigit():
        choice = int(answer)
        if 1 <= choice <= len(sessions):
            return sessions[choice - 1]
        if choice == len(sessions) + 1:
            return prompt_new_name()
    return answer


def prompt_new_name() -> str:
    name = input("new session name [main]> ").strip()
    return name or "main"


def browse(config: Config) -> int:
    if config.no_input or not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ZtError("browse requires an interactive terminal; use 'zt list', 'zt ensure SESSION', or 'zt attach SESSION'", 2)
    if config.picker == "none":
        raise ZtError("browse is disabled because picker is set to none", 2)

    sessions = list_sessions(config)
    choices = [NEW_MARKER, *sessions]
    choice = choose_with_fzf(choices) if config.picker in {"auto", "fzf"} else None
    if choice is None and config.picker == "fzf":
        raise ZtError("picker is set to fzf, but fzf is unavailable or not attached to a terminal", 2)
    if choice is None:
        choice = prompt_choice(sessions)
    if not choice:
        return 130
    if choice == NEW_MARKER:
        choice = prompt_new_name()
    return attach(config, choice, create=True, background=False, json_output=False, print_only=False)


def local_tool_status(tool: str) -> dict[str, object]:
    path = shutil.which(tool)
    if not path:
        return {"present": False, "path": None, "version": None}

    version_args = {
        "ssh": [tool, "-V"],
        "tmux": [tool, "-V"],
    }.get(tool, [tool, "--version"])
    proc = subprocess.run(version_args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    version = (proc.stdout or proc.stderr).splitlines()
    return {"present": True, "path": path, "version": version[0] if version else None}


def remote_tool_status(config: Config) -> tuple[dict[str, object], str | None]:
    script = r'''
printf 'hostname\t%s\n' "$(hostname 2>/dev/null || uname -n)"
for tool in zellij tmux mosh; do
  tool_path=$(command -v "$tool" 2>/dev/null || true)
  if [ -z "$tool_path" ]; then
    printf 'tool\t%s\t\t\n' "$tool"
    continue
  fi
  case "$tool" in
    tmux) version=$("$tool" -V 2>&1 | sed -n '1p') ;;
    *) version=$("$tool" --version 2>&1 | sed -n '1p') ;;
  esac
  printf 'tool\t%s\t%s\t%s\n' "$tool" "$tool_path" "$version"
done
'''
    proc = run_remote(config, script)
    remote: dict[str, object] = {"hostname": None, "tools": {}}
    if proc.returncode != 0:
        return remote, "\n".join(part.strip() for part in [proc.stderr, proc.stdout] if part.strip())

    tools: dict[str, object] = {}
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if not parts:
            continue
        if parts[0] == "hostname" and len(parts) >= 2:
            remote["hostname"] = parts[1]
        elif parts[0] == "tool" and len(parts) >= 4:
            tools[parts[1]] = {
                "present": bool(parts[2]),
                "path": parts[2] or None,
                "version": parts[3] or None,
            }
    remote["tools"] = tools
    return remote, None


def status(config: Config, *, json_output: bool) -> int:
    local = {tool: local_tool_status(tool) for tool in ["ssh", "mosh", "zellij", "fzf"]}
    remote, remote_error_message = remote_tool_status(config)
    remote_tools = remote.get("tools", {})
    remote_zellij = isinstance(remote_tools, dict) and remote_tools.get("zellij", {})
    remote_mosh = isinstance(remote_tools, dict) and remote_tools.get("mosh", {})

    ok = (
        local["ssh"]["present"]
        and isinstance(remote_zellij, dict)
        and bool(remote_zellij.get("present"))
        and (
            config.transport != "mosh"
            or (
                local["mosh"]["present"]
                and isinstance(remote_mosh, dict)
                and bool(remote_mosh.get("present"))
            )
        )
        and remote_error_message is None
    )
    data = {
        "ok": bool(ok),
        "host": config.host,
        "transport": config.transport,
        "picker": config.picker,
        "connect_timeout": config.connect_timeout,
        "config_path": str(config.config_path),
        "config_loaded": config.config_loaded,
        "local": local,
        "remote": remote,
        "remote_error": remote_error_message,
    }

    if json_output:
        print_json(data)
    else:
        print(f"host: {config.host}")
        print(f"transport: {config.transport}")
        print(f"picker: {config.picker}")
        print(f"config: {config.config_path} ({'loaded' if config.config_loaded else 'missing'})")
        if remote.get("hostname"):
            print(f"remote hostname: {remote['hostname']}")
        if remote_error_message:
            print(f"remote error: {remote_error_message}", file=sys.stderr)
        print("local:")
        for tool, info in local.items():
            suffix = f"{info['path']} ({info['version']})" if info["present"] else "missing"
            print(f"  {tool}: {suffix}")
        print("remote:")
        if isinstance(remote_tools, dict):
            for tool, info in remote_tools.items():
                if isinstance(info, dict):
                    suffix = f"{info['path']} ({info['version']})" if info["present"] else "missing"
                    print(f"  {tool}: {suffix}")
    return 0 if ok else 1


def detect_local_package_manager() -> str | None:
    for manager in PACKAGE_MANAGERS:
        if shutil.which(manager):
            return manager
    return None


def detect_remote_package_manager(config: Config) -> str | None:
    managers = " ".join(shlex.quote(manager) for manager in PACKAGE_MANAGERS)
    proc = run_remote(
        config,
        f'for manager in {managers}; do command -v "$manager" >/dev/null 2>&1 && '
        'printf "%s\\n" "$manager" && exit 0; done; exit 1',
    )
    if proc.returncode != 0:
        return None
    manager = proc.stdout.strip().splitlines()
    return manager[0] if manager else None


def local_missing_tools(tools: list[str]) -> list[str]:
    return [tool for tool in tools if shutil.which(tool) is None]


def remote_missing_tools(config: Config, tools: list[str]) -> list[str]:
    if not tools:
        return []
    tool_args = " ".join(shlex.quote(tool) for tool in tools)
    proc = run_remote(
        config,
        f'for tool in {tool_args}; do command -v "$tool" >/dev/null 2>&1 || printf "%s\\n" "$tool"; done',
    )
    if proc.returncode != 0:
        raise remote_error(proc, "check remote dependencies")
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def package_install_command(package_manager: str, packages: list[str]) -> str:
    package_args = " ".join(shlex.quote(package) for package in packages)
    if package_manager == "brew":
        return f"brew install {package_args}"
    if package_manager == "apt-get":
        return f"sudo apt-get update && sudo apt-get install -y {package_args}"
    if package_manager == "dnf":
        return f"sudo dnf install -y {package_args}"
    if package_manager == "pacman":
        return f"sudo pacman -S --needed --noconfirm {package_args}"
    if package_manager == "apk":
        return f"sudo apk add {package_args}"
    raise ZtError(f"unsupported package manager: {package_manager}", 2)


def install_tool_targets(config: Config, args: argparse.Namespace) -> tuple[list[str], list[str]]:
    local_tools: list[str] = []
    remote_tools = ["zellij"]

    if not args.no_fzf and config.picker in {"auto", "fzf"}:
        local_tools.append("fzf")
    if args.with_mosh or config.transport == "mosh":
        local_tools.append("mosh")
        remote_tools.append("mosh")
    if args.with_tmux:
        remote_tools.append("tmux")
    if args.with_local_zellij:
        local_tools.append("zellij")

    return sorted(set(local_tools)), sorted(set(remote_tools))


def install_scopes(args: argparse.Namespace) -> list[str]:
    if args.local_only:
        return ["local"]
    if args.remote_only:
        return ["remote"]
    return ["local", "remote"]


def build_install_plan(config: Config, args: argparse.Namespace) -> dict[str, object]:
    scopes = install_scopes(args)
    local_targets, remote_targets = install_tool_targets(config, args)
    plan: list[dict[str, object]] = []
    installed: dict[str, list[str]] = {"local": [], "remote": []}
    missing: dict[str, list[str]] = {"local": [], "remote": []}
    package_managers: dict[str, str | None] = {"local": None, "remote": None}

    if "local" in scopes and local_targets:
        installed["local"] = [tool for tool in local_targets if shutil.which(tool)]
        missing["local"] = local_missing_tools(local_targets)
        if missing["local"]:
            package_managers["local"] = detect_local_package_manager()
            if package_managers["local"] is None:
                raise ZtError("no supported local package manager found (expected brew, apt-get, dnf, pacman, or apk)", 2)
            plan.append(
                {
                    "scope": "local",
                    "package_manager": package_managers["local"],
                    "packages": missing["local"],
                    "command": package_install_command(package_managers["local"], missing["local"]),
                }
            )

    if "remote" in scopes and remote_targets:
        missing["remote"] = remote_missing_tools(config, remote_targets)
        installed["remote"] = [tool for tool in remote_targets if tool not in missing["remote"]]
        if missing["remote"]:
            package_managers["remote"] = detect_remote_package_manager(config)
            if package_managers["remote"] is None:
                raise ZtError(
                    f"no supported package manager found on {config.host} "
                    "(expected brew, apt-get, dnf, pacman, or apk)",
                    2,
                )
            plan.append(
                {
                    "scope": "remote",
                    "package_manager": package_managers["remote"],
                    "packages": missing["remote"],
                    "command": package_install_command(package_managers["remote"], missing["remote"]),
                }
            )

    return {
        "host": config.host,
        "transport": config.transport,
        "picker": config.picker,
        "scopes": scopes,
        "targets": {"local": local_targets, "remote": remote_targets},
        "installed": installed,
        "missing": missing,
        "package_managers": package_managers,
        "plan": plan,
    }


def confirm_install(plan: list[dict[str, object]], *, yes: bool, no_input: bool) -> None:
    if not plan or yes:
        return
    if no_input or not sys.stdin.isatty():
        raise ZtError("install requires --yes in noninteractive mode", 2)
    print("zt will run:")
    for entry in plan:
        print(f"  [{entry['scope']}] {entry['command']}")
    answer = input("install missing dependencies? [y/N] ").strip().lower()
    if answer not in {"y", "yes"}:
        raise ZtError("install cancelled", 130)


def run_install_entry(config: Config, entry: dict[str, object], *, json_output: bool) -> dict[str, object]:
    command = str(entry["command"])
    scope = str(entry["scope"])
    if scope == "local":
        proc = subprocess.run(command, shell=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE) if json_output else None
        if proc is None:
            returncode = subprocess.call(command, shell=True)
            return {"scope": scope, "command": command, "returncode": returncode}
        return {
            "scope": scope,
            "command": command,
            "returncode": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }

    argv = [*ssh_args(config, batch=json_output, tty=not json_output), remote_cmd(config, command)]
    if json_output:
        proc = subprocess.run(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return {
            "scope": scope,
            "command": shlex.join(argv),
            "returncode": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    returncode = subprocess.call(argv)
    return {"scope": scope, "command": shlex.join(argv), "returncode": returncode}


def install_dependencies(config: Config, args: argparse.Namespace) -> int:
    plan_data = build_install_plan(config, args)
    plan = plan_data["plan"]
    if not isinstance(plan, list):
        raise ZtError("internal install plan error", 1)

    if args.dry_run:
        if args.json:
            print_json({**plan_data, "dry_run": True})
        else:
            if plan:
                for entry in plan:
                    print(f"[{entry['scope']}] {entry['command']}")
            else:
                print("all selected dependencies are already installed")
        return 0

    confirm_install(plan, yes=args.yes, no_input=config.no_input)
    results = [run_install_entry(config, entry, json_output=args.json) for entry in plan]
    failed = [result for result in results if int(result.get("returncode", 1)) != 0]

    if args.json:
        print_json({**plan_data, "dry_run": False, "results": results, "ok": not failed})
    else:
        if not plan:
            print("all selected dependencies are already installed")
        elif failed:
            print("one or more install commands failed", file=sys.stderr)
    return 1 if failed else 0


def normalize_shortcut(argv: list[str]) -> list[str]:
    options_with_values = {"-H", "--host", "--config", "--remote-path", "--connect-timeout", "--ssh-option", "--picker"}
    skip_next = False
    for index, arg in enumerate(argv):
        if skip_next:
            skip_next = False
            continue
        if arg == "--":
            break
        if arg in options_with_values:
            skip_next = True
            continue
        if arg in ("--ssh", "--mosh", "--no-input", "-h", "--help"):
            continue
        if arg.startswith("-"):
            continue
        if arg not in COMMANDS:
            return [*argv[:index], "attach", arg, *argv[index + 1 :]]
        return argv
    return argv


def add_json_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("-j", "--json", action="store_true", help="print machine-readable JSON")


def add_session_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("session", help="Zellij session name")


def parse_args(argv: list[str]) -> argparse.Namespace:
    argv = normalize_shortcut(argv)
    parser = argparse.ArgumentParser(
        prog="zt",
        description="Remote Zellij session manager for humans and automation.",
        epilog="\n".join(
            [
                "human examples:",
                "  zt local                   attach/create local session 'main'",
                "  zt remote                  attach/create remote session 'main'",
                "  zt local work              attach/create local session 'work'",
                "  zt remote work             attach/create remote session 'work'",
                "  zt local new               attach/create an autogenerated local session",
                "  zt remote new              attach/create an autogenerated remote session",
                "  zt remote --auto           attach/create an autogenerated remote session",
                "  zt                         browse remote sessions on tmm",
                "  zt main                    remote shorthand for session 'main'",
                "  zt auto                    remote shorthand for an autogenerated session",
                "  zt --mosh remote main      attach/create remote session over mosh",
                "  zt --picker prompt         browse with numbered prompt",
                "  zt config init             write ~/.config/zt/config.toml",
                "  zt install                 install missing local/remote dependencies",
                "",
                "agent/noninteractive examples:",
                "  zt list --json             list active sessions as JSON",
                "  zt status --json           check local/remote dependencies",
                "  zt config show --json      print effective config",
                "  zt install --dry-run --json",
                "  zt install --yes --json",
                "  zt exists main --json      return 0 if active, 1 if missing",
                "  zt ensure main --json      create detached session if missing",
                "  zt attach --auto --background --json",
                "  zt attach main --background --json",
                "  zt close main --missing-ok --json",
                "  zt delete main --missing-ok --json",
                "",
                "environment:",
                "  ZT_CONFIG=~/.config/zt/config.toml ZT_HOST=tmm ZT_TRANSPORT=ssh ZT_PICKER=auto",
            ]
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--config", default=str(default_config_path()), help="config file path")
    parser.add_argument("-H", "--host", help="remote SSH host")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument(
        "--remote-path",
        help="remote PATH used before invoking zellij/mosh/tmux",
    )
    parser.add_argument(
        "--connect-timeout",
        type=int,
        help="SSH connect timeout in seconds, 0 disables the option",
    )
    parser.add_argument(
        "--ssh-option",
        action="append",
        default=None,
        help="extra ssh -o option, repeatable, e.g. --ssh-option UserKnownHostsFile=/tmp/known_hosts",
    )
    parser.add_argument("--picker", choices=sorted(PICKER_ALIASES), help="interactive picker: auto, fzf, prompt, or none")
    parser.add_argument("--no-input", action="store_true", help="fail instead of opening fzf or prompts")
    transport = parser.add_mutually_exclusive_group()
    transport.add_argument("--ssh", action="store_const", const="ssh", dest="transport", help="attach over ssh")
    transport.add_argument("--mosh", action="store_const", const="mosh", dest="transport", help="attach over mosh")
    parser.set_defaults(transport=None)

    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("browse", aliases=["b"], help="interactively pick or create a session")

    config_parser = subparsers.add_parser("config", help="inspect or create zt config")
    config_subparsers = config_parser.add_subparsers(dest="config_command")
    config_subparsers.add_parser("path", help="print config file path")
    config_show_parser = config_subparsers.add_parser("show", help="print effective config")
    add_json_argument(config_show_parser)
    config_init_parser = config_subparsers.add_parser("init", help="write a starter config file")
    config_init_parser.add_argument("--force", action="store_true", help="overwrite an existing config file")

    install_parser = subparsers.add_parser(
        "install",
        aliases=["setup", "bootstrap"],
        help="install missing local and remote dependencies",
    )
    add_json_argument(install_parser)
    install_scope = install_parser.add_mutually_exclusive_group()
    install_scope.add_argument("--local-only", action="store_true", help="only install local dependencies")
    install_scope.add_argument("--remote-only", action="store_true", help="only install remote dependencies")
    install_parser.add_argument("-y", "--yes", action="store_true", help="run install commands without prompting")
    install_parser.add_argument("--dry-run", action="store_true", help="print the install plan without running it")
    install_parser.add_argument("--with-mosh", action="store_true", help="install mosh locally and remotely")
    install_parser.add_argument("--with-tmux", action="store_true", help="install tmux on the remote host")
    install_parser.add_argument("--with-local-zellij", action="store_true", help="install zellij locally too")
    install_parser.add_argument("--no-fzf", action="store_true", help="do not install local fzf")

    local_parser = subparsers.add_parser(
        "local",
        aliases=["here", "l"],
        help="attach/create a local Zellij session",
    )
    local_parser.add_argument("session", nargs="?", default="main", help="Zellij session name (default: main; use new/auto/- for generated)")
    add_json_argument(local_parser)
    local_parser.add_argument("--auto", action="store_true", help="generate a readable unique session name")
    local_parser.add_argument("-b", "--background", action="store_true", help="create detached session and do not attach")
    local_parser.add_argument("--no-create", action="store_true", help="fail if the session does not already exist")
    local_parser.add_argument("--print-command", action="store_true", help="print the command instead of running it")

    remote_parser = subparsers.add_parser(
        "remote",
        aliases=["there", "r"],
        help="attach/create a session on the configured remote host",
    )
    remote_parser.add_argument("session", nargs="?", default="main", help="Zellij session name (default: main; use new/auto/- for generated)")
    remote_parser.add_argument("-H", "--host", help="remote SSH host")
    remote_transport = remote_parser.add_mutually_exclusive_group()
    remote_transport.add_argument("--ssh", action="store_const", const="ssh", dest="remote_transport", help="attach over ssh")
    remote_transport.add_argument("--mosh", action="store_const", const="mosh", dest="remote_transport", help="attach over mosh")
    add_json_argument(remote_parser)
    remote_parser.add_argument("--auto", action="store_true", help="generate a readable unique session name")
    remote_parser.add_argument("-b", "--background", action="store_true", help="create detached session and do not attach")
    remote_parser.add_argument("--no-create", action="store_true", help="fail if the session does not already exist")
    remote_parser.add_argument("--print-command", action="store_true", help="print the command instead of running it")

    list_parser = subparsers.add_parser("list", aliases=["ls"], help="list active sessions")
    add_json_argument(list_parser)
    list_parser.add_argument("--count", action="store_true", help="print only the number of matching sessions")
    list_parser.add_argument("--prefix", help="only include sessions starting with this prefix")
    list_parser.add_argument("--contains", help="only include sessions containing this text")
    list_parser.add_argument("--reverse", action="store_true", help="ask zellij for reverse creation order")

    status_parser = subparsers.add_parser("status", aliases=["doctor"], help="check local and remote dependencies")
    add_json_argument(status_parser)

    exists_parser = subparsers.add_parser("exists", help="test whether an active session exists")
    add_session_argument(exists_parser)
    add_json_argument(exists_parser)

    ensure_parser = subparsers.add_parser("ensure", help="create a detached session if it is missing")
    add_session_argument(ensure_parser)
    add_json_argument(ensure_parser)
    ensure_parser.add_argument("--print-command", action="store_true", help="print the ssh command instead of running it")

    attach_parser = subparsers.add_parser("attach", aliases=["a"], help="attach to a session, creating it by default")
    attach_parser.add_argument("session", nargs="?", default="main", help="Zellij session name (default: main; use new/auto/- for generated)")
    add_json_argument(attach_parser)
    attach_parser.add_argument("--auto", action="store_true", help="generate a readable unique session name")
    attach_parser.add_argument("-b", "--background", action="store_true", help="create detached session and do not attach")
    attach_parser.add_argument("--no-create", action="store_true", help="fail if the session does not already exist")
    attach_parser.add_argument("--print-command", action="store_true", help="print the command instead of running it")

    new_parser = subparsers.add_parser("new", aliases=["n"], help="create/attach a session")
    new_parser.add_argument("session", nargs="?", default="new", help="Zellij session name (default: autogenerated)")
    add_json_argument(new_parser)
    new_parser.add_argument("--auto", action="store_true", help="generate a readable unique session name")
    new_parser.add_argument("-b", "--background", action="store_true", help="create detached session and do not attach")
    new_parser.add_argument("--print-command", action="store_true", help="print the command instead of running it")

    kill_parser = subparsers.add_parser("kill", aliases=["k", "close"], help="close a running session")
    add_session_argument(kill_parser)
    add_json_argument(kill_parser)
    kill_parser.add_argument("--missing-ok", action="store_true", help="exit 0 if the session is already missing")

    delete_parser = subparsers.add_parser(
        "delete",
        aliases=["d", "rm"],
        help="close and delete a session, including saved state",
    )
    add_session_argument(delete_parser)
    add_json_argument(delete_parser)
    delete_parser.add_argument("--no-force", action="store_true", help="only delete if the session is not running")
    delete_parser.add_argument("--missing-ok", action="store_true", help="exit 0 if the session is already missing")

    return parser.parse_args(argv)


def build_config(args: argparse.Namespace) -> Config:
    values, config_path, config_loaded = effective_config_values(args)
    return Config(
        host=str(values["host"]),
        transport=str(values["transport"]),
        picker=str(values["picker"]),
        remote_path=str(values["remote_path"]),
        connect_timeout=int(values["connect_timeout"]),
        ssh_options=tuple(str(option) for option in values["ssh_options"]),
        no_input=bool(values["no_input"]),
        config_path=config_path,
        config_loaded=config_loaded,
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    config = build_config(args)

    if args.command in ("browse", "b"):
        return browse(config)

    if args.command == "config":
        config_command = args.config_command or "show"
        if config_command == "path":
            print(config.config_path)
            return 0
        if config_command == "show":
            if getattr(args, "json", False):
                print_json(config_to_json(config))
            else:
                for key, value in config_to_json(config).items():
                    if isinstance(value, list):
                        value = ", ".join(value)
                    print(f"{key}: {value}")
            return 0
        if config_command == "init":
            if config.config_path.exists() and not args.force:
                raise ZtError(f"config already exists: {config.config_path} (use --force to overwrite)", 2)
            config.config_path.parent.mkdir(parents=True, exist_ok=True)
            config.config_path.write_text(default_config_text())
            print(config.config_path)
            return 0

    if args.command in ("install", "setup", "bootstrap"):
        return install_dependencies(config, args)

    if args.command in ("local", "here", "l"):
        session = resolve_session_name(args.session, auto=args.auto, scope="local")
        return attach_local(
            session,
            create=not args.no_create,
            background=args.background,
            json_output=args.json,
            print_only=args.print_command,
        )

    if args.command in ("remote", "there", "r"):
        session = resolve_session_name(args.session, auto=args.auto, scope="remote", host=config.host)
        return attach(
            config,
            session,
            create=not args.no_create,
            background=args.background,
            json_output=args.json,
            print_only=args.print_command,
        )

    if args.command in ("list", "ls"):
        sessions = filter_sessions(
            list_sessions(config, reverse=args.reverse),
            prefix=args.prefix,
            contains=args.contains,
        )
        if args.json:
            print_json({"host": config.host, "sessions": sessions, "count": len(sessions)})
        elif args.count:
            print(len(sessions))
        else:
            for session in sessions:
                print(session)
        return 0

    if args.command in ("status", "doctor"):
        return status(config, json_output=args.json)

    if args.command == "exists":
        exists = session_exists(config, args.session)
        if args.json:
            print_json({"host": config.host, "session": args.session, "exists": exists})
        return 0 if exists else 1

    if args.command == "ensure":
        return ensure_session(config, args.session, json_output=args.json, print_only=args.print_command)

    if args.command in ("attach", "a"):
        session = resolve_session_name(args.session, auto=args.auto, scope="remote", host=config.host)
        return attach(
            config,
            session,
            create=not args.no_create,
            background=args.background,
            json_output=args.json,
            print_only=args.print_command,
        )

    if args.command in ("new", "n"):
        session = resolve_session_name(args.session, auto=args.auto, scope="remote", host=config.host)
        return attach(
            config,
            session,
            create=True,
            background=args.background,
            json_output=args.json,
            print_only=args.print_command,
        )

    if args.command in ("kill", "k", "close"):
        return kill_session(config, args.session, missing_ok=args.missing_ok, json_output=args.json)

    if args.command in ("delete", "d", "rm"):
        return delete_session(config, args.session, force=not args.no_force, missing_ok=args.missing_ok, json_output=args.json)

    if config.no_input or not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ZtError("no command provided; use 'zt --help' for noninteractive commands", 2)
    return browse(config)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except ZtError as exc:
        print(f"zt: {exc}", file=sys.stderr)
        raise SystemExit(exc.code)

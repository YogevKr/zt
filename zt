class ZtError(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


@dataclass(frozen=True)
class Config:
    host: str
    transport: str
    picker: str
    remote_path: str
    connect_timeout: int
    ssh_options: tuple[str, ...]
    no_input: bool
    config_path: Path
    config_loaded: bool


def remote_cmd(config: Config, command: str) -> str:
    return f"PATH={config.remote_path}; {command}"


def ssh_args(config: Config, *, batch: bool, tty: bool = False) -> list[str]:
    args = ["ssh"]
    if tty:
        args.append("-t")
    if batch:
        args.extend(["-o", "BatchMode=yes"])
    if config.connect_timeout > 0:
        args.extend(["-o", f"ConnectTimeout={config.connect_timeout}"])
    for option in config.ssh_options:
        args.extend(["-o", option])
    args.append(config.host)
    return args


def run_remote(config: Config, command: str, *, batch: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [*ssh_args(config, batch=batch), remote_cmd(config, command)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def remote_error(proc: subprocess.CompletedProcess[str], action: str) -> ZtError:
    detail = "\n".join(part.strip() for part in [proc.stderr, proc.stdout] if part.strip())
    return ZtError(f"{action} failed on remote host: {detail or f'exit {proc.returncode}'}", proc.returncode or 1)


def print_json(data: object) -> None:
    print(json.dumps(data, sort_keys=True))


def print_command(argv: list[str]) -> None:
    print(shlex.join(argv))


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return slug or "zt"


def auto_session_name(scope: str, *, host: str | None = None, prefix: str | None = None) -> str:
    if prefix:
        base = prefix
    elif scope == "local":
        base = "mb"
    else:
        base = host or "remote"
    return f"{slugify(base)}-{datetime.now().strftime('%Y%m%d-%H%M%S')}-{secrets.token_hex(2)}"


def resolve_session_name(session: str | None, *, auto: bool, scope: str, host: str | None = None, default: str = "main") -> str:
    if auto or session in AUTO_SESSION_MARKERS:
        return auto_session_name(scope, host=host)
    return session or default


def default_config_path() -> Path:
    return Path(os.environ.get(CONFIG_ENV, DEFAULT_CONFIG_PATH)).expanduser()


def parse_bool(value: object, *, key: str) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "on"}:
            return True
        if normalized in {"0", "false", "no", "off"}:
            return False
    raise ZtError(f"{key} must be a boolean", 2)


def parse_int(value: object, *, key: str) -> int:
    if isinstance(value, bool):
        raise ZtError(f"{key} must be an integer", 2)
    try:
        parsed = int(value)
    except (TypeError, ValueError) as exc:
        raise ZtError(f"{key} must be an integer", 2) from exc
    if parsed < 0:
        raise ZtError(f"{key} must be >= 0", 2)
    return parsed


def parse_list(value: object, *, key: str) -> list[str]:
    if value is None:
        return []
    if isinstance(value, str):
        return [item for item in value.split(",") if item]
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return value
    raise ZtError(f"{key} must be a string list", 2)


def normalize_transport(value: object) -> str:
    if not isinstance(value, str):
        raise ZtError("transport must be a string", 2)
    normalized = value.strip().lower()
    if normalized not in VALID_TRANSPORTS:
        raise ZtError(f"transport must be one of: {', '.join(sorted(VALID_TRANSPORTS))}", 2)
    return normalized


def normalize_picker(value: object) -> str:
    if not isinstance(value, str):
        raise ZtError("picker must be a string", 2)
    normalized = value.strip().lower()
    if normalized not in PICKER_ALIASES:
        raise ZtError("picker must be one of: auto, fzf, prompt, numbered, none", 2)
    return PICKER_ALIASES[normalized]


def normalize_config_values(values: dict[str, object]) -> dict[str, object]:
    normalized: dict[str, object] = {}
    for key, value in values.items():
        if key == "host":
            if not isinstance(value, str) or not value:
                raise ZtError("host must be a non-empty string", 2)
            normalized[key] = value
        elif key == "transport":
            normalized[key] = normalize_transport(value)
        elif key == "picker":
            normalized[key] = normalize_picker(value)
        elif key == "remote_path":
            if not isinstance(value, str) or not value:
                raise ZtError("remote_path must be a non-empty string", 2)
            normalized[key] = value
        elif key == "connect_timeout":
            normalized[key] = parse_int(value, key=key)
        elif key == "ssh_options":
            normalized[key] = parse_list(value, key=key)
        elif key == "no_input":
            normalized[key] = parse_bool(value, key=key)
        else:
            raise ZtError(f"unknown config key: {key}", 2)
    return normalized


def read_config_file(path: Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        with path.open("rb") as file:
            raw = tomllib.load(file)
    except OSError as exc:
        raise ZtError(f"could not read config file {path}: {exc}", 2) from exc
    except tomllib.TOMLDecodeError as exc:
        raise ZtError(f"could not parse config file {path}: {exc}", 2) from exc

    defaults = raw.get("defaults", raw)
    if not isinstance(defaults, dict):
        raise ZtError("config [defaults] must be a table", 2)
    return normalize_config_values(defaults)


def env_config_values() -> dict[str, object]:
    values: dict[str, object] = {}
    for env_name, key in ENV_TO_CONFIG_KEY.items():
        if env_name in os.environ:
            values[key] = os.environ[env_name]
    return normalize_config_values(values)


def effective_config_values(args: argparse.Namespace) -> tuple[dict[str, object], Path, bool]:
    config_path = Path(args.config).expanduser()
    file_values = read_config_file(config_path)
    values = dict(BUILTIN_DEFAULTS)
    values.update(file_values)
    values.update(env_config_values())

    cli_values: dict[str, object] = {}
    for key in ["host", "remote_path", "connect_timeout", "picker"]:
        value = getattr(args, key)
        if value is not None:
            cli_values[key] = value
    remote_transport = getattr(args, "remote_transport", None)
    if remote_transport is not None:
        cli_values["transport"] = remote_transport
    elif args.transport is not None:
        cli_values["transport"] = args.transport
    if args.ssh_option:
        cli_values["ssh_options"] = args.ssh_option
    if args.no_input:
        cli_values["no_input"] = True
    values.update(normalize_config_values(cli_values))
    return values, config_path, bool(file_values)


